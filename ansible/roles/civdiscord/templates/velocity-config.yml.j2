discord:
  token: "{{ vault_discord_token }}"
  home_guild_id: {{ vault_discord_guild_id }}

database:
  path: civdiscord.db

namelayer_db:
  host: "{{ vault_namelayer_db_host }}"
  port: {{ vault_namelayer_db_port }}
  user: "{{ vault_namelayer_db_user }}"
  password: "{{ vault_namelayer_db_password }}"
  database: "{{ vault_namelayer_db_name }}"

bridge:
  hmac_enabled: {{ civdiscord_bridge_hmac_enabled | lower }}

